DELPHI_NETWORK=competition-testnet
DELPHI_API_ACCESS_KEY=

# Before adding credentials, review TERMS.md and PRIVACY.md.
# Live wallet details can be stored in the local ledger and sent to configured providers.

# Optional: omit to use the active competition.
# DELPHI_COMPETITION_ID=

# Choose one signer supported by the Delphi SDK. Never commit these values.
# DELPHI_SIGNER_TYPE=private_key
# WALLET_PRIVATE_KEY=0x...
# Set this to the exact wallet registered on DoraHacks so preflight can detect a signer mismatch.
# DELPHI_REGISTERED_WALLET_ADDRESS=0x...

# Live orders require both switches. Dry-run is the default.
ALLOW_LIVE_TRADING=false
SETTLEMENT_EDGE_EXECUTE=false

# Bankroll and risk policy, denominated in competition TST.
SETTLEMENT_EDGE_BANKROLL_TST=100
SETTLEMENT_EDGE_MIN_EDGE=0.08
SETTLEMENT_EDGE_MAX_TRADE_TST=10
SETTLEMENT_EDGE_MAX_BANKROLL_PCT=0.10
SETTLEMENT_EDGE_MAX_PRICE_IMPACT=0.03
SETTLEMENT_EDGE_MAX_SOURCE_AGE_MINUTES=15
# Optional minimum readiness balances. Defaults: 0.0001 ETH and max trade TST.
# SETTLEMENT_EDGE_MIN_ETH_BALANCE=0.0001
# SETTLEMENT_EDGE_MIN_TST_BALANCE=10

# Continuous watcher timing in milliseconds.
SETTLEMENT_EDGE_POLL_INTERVAL_MS=60000
SETTLEMENT_EDGE_RETRY_BASE_MS=1000
SETTLEMENT_EDGE_RETRY_MAX_MS=30000
# Optional durable ledger and restart-state destinations.
# SETTLEMENT_EDGE_RECEIPT_PATH=artifacts/decision-receipts.jsonl
# SETTLEMENT_EDGE_WATCHER_STATE_PATH=artifacts/watcher-state.json
